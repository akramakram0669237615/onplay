# ==========================================
# ONPLAY ROOT .HTACCESS
# المسار: /onply/.htaccess
# ==========================================

RewriteEngine On


# ==========================================
# 1. لوحة التحكم
# لا تحول روابط admin إلى API
# ==========================================

RewriteRule ^admin/ - [L]


# ==========================================
# 2. الملفات والمجلدات الموجودة فعلياً
# ==========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d

RewriteRule ^ - [L]


# ==========================================
# 3. API
# ==========================================

RewriteRule ^api/(.*)$ public/index.php [QSA,L]


# ==========================================
# 4. API مع public في الرابط
# ==========================================

RewriteRule ^public/api/(.*)$ public/index.php [QSA,L]